#!/usr/bin/env bash
set -euo pipefail

# git exports GIT_DIR/GIT_INDEX_FILE to hooks; in linked worktrees they point
# at the shared git dir, so test binaries that run git commands in temp
# directories resolve against THIS repository instead of their sandbox (stray
# "init" commits from the staged index, core.bare flipped in the shared config).
# Strip the repo-pointing environment for go invocations that execute tests.
go_sandbox() {
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
        -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
        -u GIT_COMMON_DIR "$@"
}

echo "==> Running go build..."
go build ./...

echo "==> Running golangci-lint..."
# Test if golangci-lint is both available and executable (AppLocker may block it)
if command -v golangci-lint &>/dev/null && golangci-lint version &>/dev/null; then
    golangci-lint run ./...
else
    echo "    golangci-lint not found or not executable, falling back to go vet"
    go vet ./...
fi

echo "==> Running tests..."
# On Windows, AppLocker may block test executables from %TEMP%.
# Redirect Go's temp dir to a location that AppLocker allows.
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" || "$OSTYPE" == "cygwin" ]]; then
    GOTMPDIR="${GOTMPDIR:-$HOME/.cache/go-test-tmp}"
    mkdir -p "$GOTMPDIR"
    export GOTMPDIR
fi
go_sandbox go test ./...

echo "==> All checks passed"
